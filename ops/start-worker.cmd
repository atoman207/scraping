@echo off
chcp 65001 > nul
title 転売リサーチツール - ワーカー(スクレイピング)
cd /d "%~dp0.."

echo ============================================================
echo  ワーカーを起動します
echo  画面から実行したリサーチを、ここが拾って処理します
echo  停止するには、このウィンドウで Ctrl+C を押してください
echo ============================================================
echo.

REM 落ちても自動で立ち上げ直す。
REM (メルカリ側のブロックやネットワーク断で終了しても、運用が止まらないようにするため)
:loop
call npm run worker
echo.
echo [%date% %time%] ワーカーが終了しました。10秒後に再起動します。
echo   意図的に止めたい場合は、このウィンドウを閉じてください。
timeout /t 10 /nobreak > nul
goto loop
