# ---- Supabase ----
# Supabaseダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# サーバー側(Server Component / Server Action / CLIスクリプト)からのみ使用。
# ブラウザには絶対に露出しないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- スキーマ適用 (npm run db:push) 用の直接接続 ----
# Supabaseダッシュボード > Project Settings > Database > Connection string (URI)
# 未設定でもよい(その場合はSQL Editorに supabase/schema.sql を貼って実行)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---- Basic認証(任意・ログイン画面の手前にもう1枚の壁) ----
# 未設定なら何もしません。ログイン自体は下の管理者アカウントで行います。
BASIC_AUTH_USER=friend
BASIC_AUTH_PASS=change-me-to-a-random-password

# ---- 管理者アカウント ----
# 既定の管理者は lib/auth.ts に固定されており、**環境変数では変更できません**。
# (以前の ADMIN_USERNAME / ADMIN_PASSWORD は参照されなくなりました)
# 外からの入口を絞りたい場合は、上の BASIC_AUTH_USER / BASIC_AUTH_PASS を使ってください。

# ---- Cookie の Secure 属性(任意) ----
# 未設定なら、リクエストの x-forwarded-proto を見て自動で判断します。
#   ・LAN内で http://<IPアドレス>:3000 で使う → 未設定のままでOK(自動でオフ)
#   ・HTTPSで公開し、プロキシが x-forwarded-proto を付けない → COOKIE_SECURE=1
# HTTPS で公開しているのに 0 にすると、盗聴でセッションを盗まれます。
# COOKIE_SECURE=1

# ---- 1688Japan(1688の公式総代理店。仕入れ候補の取得に使う) ----
# セッションは `npm run login:1688jp` で作る。ここに ID/パスワードを入れておくと、
# 入り直すときに自動で埋まるので、画像の確認コード4桁だけ打てば済む。
SOURCING_1688JP_USER=
SOURCING_1688JP_PASS=
# セッションの置き場所を変えたいときだけ(既定は secrets/1688japan-state.json)
# SOURCING_1688JP_STATE=
