# ---- Supabase ----
# Supabaseダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# サーバー側(Server Component / Server Action / CLIスクリプト)からのみ使用。
# ブラウザには絶対に露出しないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- スキーマ適用 (npm run db:push) 用の直接接続 ----
# Supabaseダッシュボード > Project Settings > Database > Connection string (URI)
# 未設定でもよい(その場合はSQL Editorに supabase/schema.sql を貼って実行)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---- Basic認証(元の webapp と同じ。未設定なら認証スキップ) ----
BASIC_AUTH_USER=friend
BASIC_AUTH_PASS=change-me-to-a-random-password
